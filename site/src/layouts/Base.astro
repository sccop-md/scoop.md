---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { GITHUB_URL, CONTACT_EMAIL } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Scoop any doc. One click on any documentation site copies agent-ready Markdown for Claude Code, Codex, Cursor or any coding agent.',
} = Astro.props;
const fullTitle = title ? `${title} · scoop.md` : 'scoop.md: Scoop any doc';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site ?? 'https://scoop.md');
const nav = [
  { href: '/library', label: 'Library' },
  { href: GITHUB_URL, label: 'GitHub' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f4fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110b22" media="(prefers-color-scheme: dark)" />
    <meta property="og:image" content="https://scoop.md/icon-512.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="scoop.md home">
          <Logo />
          <span class="word">scoop<span class="ext">.md</span></span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p class="sign">
          <Logo size={20} />
          <span><strong>scoop.md</strong>: scoop any doc.</span>
        </p>
        <ul>
          <li><a href="/library">Library</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href={GITHUB_URL}>Source</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        </ul>
        <p class="fine muted">
          Documentation in the library belongs to its publishers and links back to them.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font: 700 1.25rem/1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .ext {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85em;
    color: var(--muted);
  }

  nav ul,
  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  nav a {
    font: 500 0.95rem/1 var(--font-mono);
    text-decoration: none;
    padding: 0.5rem 0;
    display: inline-block;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 6rem;
    padding: 2.5rem 0 3rem;
    font-size: 0.95rem;
  }

  .foot {
    display: grid;
    gap: 1rem;
  }

  .sign {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .foot ul a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .fine {
    margin: 0;
    font-size: 0.875rem;
  }
</style>
