---
import Base from '../layouts/Base.astro';
import Unavailable from '../components/Unavailable.astro';
import { listSites } from '../lib/api';
import { ago, bytes, plural, KIND_LABEL } from '../lib/format';

export const prerender = false;

const result = await listSites(100);
Astro.response.headers.set(
  'Cache-Control',
  result.ok ? 'public, max-age=60, s-maxage=60' : 'public, max-age=0, s-maxage=10',
);
if (!result.ok) Astro.response.status = 503;
const sites = result.ok ? result.data : [];
---

<Base title="Library" description="Documentation sites with a scoop people confirmed worked, most recently confirmed first.">
  <div class="wrap page">
    <header class="head">
      <p class="eyebrow">library</p>
      <h1>The library</h1>
      <p class="sub">
        Sites with a scoop that people confirmed worked, most recently confirmed first. When you scoop one of these
        sites, this is what you get.
      </p>
    </header>

    {!result.ok && <Unavailable path="/v1/sites" />}

    {
      result.ok && sites.length === 0 && (
        <div class="empty">
          <h2>Nothing confirmed yet</h2>
          <p>
            A site shows up here once someone scoops it and says it worked. Install the extension, scoop the docs you're
            working with, and tell it how it went.
          </p>
        </div>
      )
    }

    {
      result.ok && sites.length > 0 && (
        <table class="sites">
          <caption class="sr-only">Sites in the library</caption>
          <thead>
            <tr>
              <th scope="col">Site</th>
              <th scope="col">Sources</th>
              <th scope="col" class="num">Worked</th>
              <th scope="col">Last confirmed</th>
            </tr>
          </thead>
          <tbody>
            {sites.map(({ site, best }) => (
              <tr>
                <th scope="row" data-label="Site">
                  <a href={`/${site}`}>{site}</a>
                </th>
                <td data-label="Sources">
                  <span class="count">{plural(best.sources.length, 'source')}</span>
                  <span class="kinds">
                    {[...new Set(best.sources.map((s) => s.kind))].map((k) => (
                      <span class={`kind kind--${k}`}>{KIND_LABEL[k] ?? k}</span>
                    ))}
                  </span>
                  <span class="size muted">{bytes(best.sizeBytes)}</span>
                </td>
                <td data-label="Worked" class="num">
                  <strong>{best.worked}×</strong>
                  {best.failed > 0 && <span class="muted"> · {best.failed} didn't</span>}
                </td>
                <td data-label="Last confirmed">
                  <time datetime={best.lastWorkedAt ?? undefined}>{ago(best.lastWorkedAt)}</time>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .head {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .sub {
    max-width: 60ch;
    color: var(--ink-2);
  }

  .empty {
    border-top: 2px solid var(--rule-strong);
    padding-top: 1.5rem;
    max-width: 44rem;
  }

  .empty h2 {
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }

  .sites {
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--rule-strong);
  }

  th,
  td {
    text-align: left;
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: baseline;
  }

  thead th {
    font: 500 0.8rem/1.2 var(--font-mono);
    color: var(--muted);
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }

  tbody th {
    font: 600 1.05rem/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }

  tbody th a {
    text-decoration: none;
  }

  tbody th a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--mark) 10%, transparent);
  }

  .num {
    white-space: nowrap;
  }

  .count {
    margin-right: 0.5rem;
  }

  .kinds {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-right: 0.5rem;
  }

  .size {
    font: 400 0.85rem/1 var(--font-mono);
  }

  time {
    font: 400 0.9rem/1 var(--font-mono);
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    tr,
    tbody th,
    tbody td {
      display: block;
    }

    tr {
      padding: 1rem 0;
      border-bottom: 1px solid var(--rule);
    }

    tbody th,
    tbody td {
      border: 0;
      padding: 0.15rem 0;
    }

    tbody td::before {
      content: attr(data-label) ': ';
      font: 400 0.8rem/1 var(--font-mono);
      color: var(--muted);
    }
  }
</style>
