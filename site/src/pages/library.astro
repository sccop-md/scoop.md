---
import Base from '../layouts/Base.astro';
import Unavailable from '../components/Unavailable.astro';
import { listLlms } from '../lib/api';
import { plural } from '../lib/format';

export const prerender = false;

const result = await listLlms(200);
Astro.response.headers.set(
  'Cache-Control',
  result.ok ? 'public, max-age=60, s-maxage=60' : 'public, max-age=0, s-maxage=10',
);
if (!result.ok) Astro.response.status = 503;
const sites = result.ok ? result.data : [];
// Site icons come from Google's favicon service; a letter tile shows if one fails.
const icon = (host: string) => `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=64`;
---

<Base title="Library" description="Docs sites with an llms.txt, ready to scoop.">
  <div class="wrap page">
    <header class="head">
      <h1>Library</h1>
      <p class="sub">Docs sites with an llms.txt, most scooped first.</p>
      {
        result.ok && sites.length > 0 && (
          <div class="tools">
            <label class="search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
              <span class="sr-only">Search sites</span>
              <input type="search" placeholder="Search docs" autocomplete="off" spellcheck="false" />
            </label>
            <span class="count" aria-live="polite">{plural(sites.length, 'site')}</span>
          </div>
        )
      }
    </header>

    {!result.ok && <Unavailable path="/v1/llms/index" />}

    {
      result.ok && sites.length === 0 && (
        <div class="empty">
          <h2>Nothing here yet</h2>
          <p>Sites appear the first time someone scoops them.</p>
        </div>
      )
    }

    {
      result.ok && sites.length > 0 && (
        <ul class="grid">
          {sites.map((s) => (
            <li class="card" data-q={`${s.title ?? ''} ${s.host}`.toLowerCase()}>
              <a class="main" href={s.docsRoot} rel="noopener">
                <span class="fav" data-letter={(s.title ?? s.host).charAt(0).toUpperCase()}>
                  <img src={icon(s.host)} width="28" height="28" alt="" loading="lazy" referrerpolicy="no-referrer" />
                </span>
                <span class="name">
                  <b>{s.title ?? s.host}</b>
                  <span class="host">{s.host}</span>
                </span>
              </a>
              <div class="meta">
                <span class="pages">{plural(s.pages, 'page')}</span>
                <span class:list={['src', { own: s.source === 'site' }]} title={s.source === 'site' ? 'Published by the site' : 'Prepared by scoop.md'}>
                  {s.source === 'site' ? 'Official' : 'By scoop.md'}
                </span>
                <a class="llms" href={s.llmsUrl} rel="noopener">llms.txt ↗</a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <p class="none" hidden>No sites match.</p>
  </div>
</Base>

<script>
  // Broken favicons fall back to the letter tile
  document.querySelectorAll<HTMLImageElement>('.fav img').forEach((img) => {
    const fail = () => img.parentElement?.classList.add('noimg');
    if (img.complete && img.naturalWidth === 0) fail();
    else img.addEventListener('error', fail);
  });

  // Filter as you type
  const input = document.querySelector<HTMLInputElement>('.search input');
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = document.querySelector<HTMLElement>('.count');
  const none = document.querySelector<HTMLElement>('.none');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const hit = !q || (c.dataset.q ?? '').includes(q);
      c.hidden = !hit;
      if (hit) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'site' : 'sites'}`;
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .page {
    padding-top: clamp(3rem, 8vw, 5.5rem);
    padding-bottom: var(--section);
  }

  .head {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .sub {
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 0 1 380px;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--sheet);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .search:focus-within {
    box-shadow: inset 0 0 0 1.5px var(--ink-2);
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 46px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: 400 1rem/1 var(--font-body);
  }

  .count {
    flex: none;
    white-space: nowrap;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 20px;
    border-radius: var(--radius-card);
    background: var(--sheet);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .card[hidden] {
    display: none;
  }

  .main {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    text-decoration: none;
  }

  .fav {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--tint);
  }

  .fav img {
    width: 24px;
    height: 24px;
    border-radius: 4px;
  }

  .fav.noimg img {
    display: none;
  }

  .fav.noimg::after {
    content: attr(data-letter);
    font-weight: 600;
    color: var(--ink-2);
  }

  .name {
    display: grid;
    min-width: 0;
  }

  .name b {
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .host {
    font-size: 0.875rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-size: 0.8125rem;
  }

  .pages {
    color: var(--ink-2);
    font-weight: 500;
  }

  .src {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--ink-2);
  }

  .src.own {
    background: var(--mark-soft);
    color: var(--accent);
  }

  .llms {
    margin-left: auto;
    color: var(--muted);
    text-decoration: none;
  }

  .llms:hover {
    color: var(--ink);
  }

  .empty,
  .none {
    padding: 3rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--sheet);
    text-align: center;
    color: var(--ink-2);
  }

  .empty h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--ink);
  }

  .empty p {
    margin: 0;
  }
</style>
