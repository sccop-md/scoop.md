---
import Base from '../layouts/Base.astro';
import { CHROME_STORE_URL, GITHUB_URL } from '../lib/links';

export const prerender = true;

const agents = [
  ['claude', 'Claude Code'],
  ['openai', 'Codex'],
  ['cursor', 'Cursor'],
  ['githubcopilot', 'Copilot'],
  ['windsurf', 'Windsurf'],
  ['googlegemini', 'Gemini CLI'],
];
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">Scoop <span class="mark">any</span> doc.</h1>
    <p class="lede">One click copies any docs page as Markdown for your coding agent.</p>

    <div class="cta">
      <a class="btn" href={CHROME_STORE_URL ?? GITHUB_URL}>
        {CHROME_STORE_URL ? 'Add to Chrome' : 'Coming soon to Chrome'} <span aria-hidden="true">→</span>
      </a>
      <a class="quiet" href="/library">Browse the library</a>
    </div>

    <p class="paste muted">Paste into</p>
    <ul class="agents">
      {
        agents.map(([logo, name]) => (
          <li>
            <span class="logo" style={`--logo:url(/agents/${logo}.svg)`} aria-hidden="true" />
            {name}
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(4rem, 14vh, 9rem);
    padding-bottom: clamp(4rem, 14vh, 9rem);
  }

  h1 {
    font-size: clamp(3rem, 1.5rem + 8vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0 0 1.25rem;
  }

  .lede {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--ink-2);
    max-width: 34ch;
    margin: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 2.25rem 0 3.5rem;
  }

  .quiet {
    color: var(--ink-2);
    font-weight: 500;
  }

  .paste {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }

  .agents {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agents li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .logo {
    width: 15px;
    height: 15px;
    flex: none;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>
