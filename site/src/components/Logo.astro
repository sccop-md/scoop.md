---
// The app icon (brand/icon-source.png, built by scripts/make-icons.py). Decorative next to the wordmark.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<img src="/icon-192.png" width={size} height={size} alt="" class="logo-mark" />

<style>
  .logo-mark {
    display: block;
    flex: none;
  }
</style>
