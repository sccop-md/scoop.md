---
// The mark: a scoop lifting lines of text. Decorative next to the wordmark.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
  <rect x="7" y="5" width="12" height="2.6" rx="1.3" fill="currentColor" />
  <rect x="5" y="10" width="16" height="2.6" rx="1.3" fill="currentColor" />
  <path d="M3 15.5h20a10 10 0 0 1-20 0Z" fill="var(--mark)" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
  <path d="M23 15.5l6.5-6.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
</svg>
